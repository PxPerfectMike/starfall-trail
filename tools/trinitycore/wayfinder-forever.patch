@@ -24,6 +24,90 @@
 #include "VMapManager.h"
 #include <DetourNavMeshBuilder.h>
 
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <vector>
+
+// Wayfinder: tag road and trail ground from a texture-derived road map (roadmask_<map>.bin in the
+// working directory: float x0, y0, step; uint32 nx, ny; then nx * ny weights 0..255, row-major,
+// x = (x0 - recastX) / step, y = (y0 - recastZ) / step). Recast builds regions per area, so the
+// resulting polygons follow road edges.
+namespace
+{
+    struct WayfinderRoadMask
+    {
+        float x0 = 0.0f, y0 = 0.0f, step = 1.0f;
+        uint32 nx = 0, ny = 0;
+        std::vector<uint8> data;
+        bool loaded = false;
+    };
+
+    std::mutex wayfinderRoadMaskLock;
+    std::map<uint32, WayfinderRoadMask> wayfinderRoadMasks;
+
+    WayfinderRoadMask const* GetWayfinderRoadMask(uint32 mapId)
+    {
+        std::lock_guard<std::mutex> guard(wayfinderRoadMaskLock);
+        WayfinderRoadMask& mask = wayfinderRoadMasks[mapId];
+        if (!mask.loaded)
+        {
+            mask.loaded = true;
+            char name[64];
+            snprintf(name, sizeof(name), "roadmask_%04u.bin", mapId);
+            if (FILE* f = fopen(name, "rb"))
+            {
+                float header[3];
+                uint32 dims[2];
+                if (fread(header, sizeof(float), 3, f) == 3 && fread(dims, sizeof(uint32), 2, f) == 2)
+                {
+                    mask.x0 = header[0];
+                    mask.y0 = header[1];
+                    mask.step = header[2];
+                    mask.nx = dims[0];
+                    mask.ny = dims[1];
+                    mask.data.resize(size_t(mask.nx) * mask.ny);
+                    if (fread(mask.data.data(), 1, mask.data.size(), f) != mask.data.size())
+                        mask.data.clear();
+                }
+                fclose(f);
+            }
+        }
+        return mask.data.empty() ? nullptr : &mask;
+    }
+
+    constexpr unsigned char WAYFINDER_AREA_ROAD = 7;   // below NAV_AREA_MIN_VALUE, unused by TrinityCore
+    constexpr unsigned char WAYFINDER_AREA_TRAIL = 6;
+
+    void MarkWayfinderRoads(uint32 mapId, rcCompactHeightfield& chf)
+    {
+        WayfinderRoadMask const* mask = GetWayfinderRoadMask(mapId);
+        if (!mask)
+            return;
+        for (int y = 0; y < chf.height; ++y)
+        {
+            for (int x = 0; x < chf.width; ++x)
+            {
+                rcCompactCell const& cell = chf.cells[x + y * chf.width];
+                float rx = chf.bmin[0] + (x + 0.5f) * chf.cs;
+                float rz = chf.bmin[2] + (y + 0.5f) * chf.cs;
+                int i = int((mask->x0 - rx) / mask->step);
+                int j = int((mask->y0 - rz) / mask->step);
+                if (i < 0 || j < 0 || i >= int(mask->nx) || j >= int(mask->ny))
+                    continue;
+                uint8 weight = mask->data[size_t(j) * mask->nx + i];
+                unsigned char area = weight >= 160 ? WAYFINDER_AREA_ROAD : (weight >= 90 ? WAYFINDER_AREA_TRAIL : 0);
+                if (!area)
+                    continue;
+                for (unsigned int s = cell.index, end = cell.index + cell.count; s < end; ++s)
+                    if (chf.areas[s] == NAV_AREA_GROUND)
+                        chf.areas[s] = area;
+            }
+        }
+    }
+}
